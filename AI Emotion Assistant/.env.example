NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
MODEL_PROVIDER=disabled
# Switch to dashscope only after the adapter tests pass.
# API keys and compatible endpoints differ by region and workspace.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RISK_MODEL=qwen3.7-plus-2026-05-26
DASHSCOPE_GENERATION_MODEL=qwen3.7-plus-2026-05-26
MODEL_TIMEOUT_MS=12000
MODEL_MAX_RETRIES=1
